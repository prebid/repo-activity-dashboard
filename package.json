{
  "name": "repo-activity-dashboard",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "node scripts/app.mjs dev preview",
    "build": "node scripts/app.mjs build preview",
    "start": "node scripts/app.mjs start preview",
    "build:production": "node scripts/app.mjs build production",
    "start:production": "node scripts/app.mjs start production",
    "lint": "eslint src tests scripts .storybook eslint.config.mjs next.config.mjs postcss.config.cjs playwright.config.ts vitest.config.ts --max-warnings=0",
    "format": "prettier --write src tests scripts .storybook *.mjs *.cjs *.ts *.json *.yml .github",
    "format:check": "prettier --check src tests scripts .storybook *.mjs *.cjs *.ts *.json *.yml .github",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:boundaries && npm test",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "check:all": "npm run check && npm run build && npm run build:storybook && npm run test:e2e",
    "preview:storybook": "vite preview --outDir storybook-static --host 127.0.0.1 --port 6007 --strictPort"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.64.1",
    "@storybook/nextjs-vite": "10.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "jsdom": "^27.0.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.893.0",
    "@aws-sdk/lib-dynamodb": "^3.893.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "uuid": "^13.0.0",
    "@tanstack/react-table": "9.3.1",
    "next-themes": "0.4.6",
    "react-is": "19.3.1",
    "server-only": "0.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
