{
  "name": "repo-activity-dashboard",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "node scripts/app.mjs dev preview",
    "build": "node scripts/app.mjs build production",
    "start": "node scripts/app.mjs start production",
    "build:production": "node scripts/app.mjs build production",
    "start:production": "node scripts/app.mjs start production",
    "lint": "eslint src tests scripts .storybook *.mjs *.cjs *.ts --max-warnings=0 --no-warn-ignored",
    "format": "prettier --write src tests scripts .storybook *.mjs *.cjs *.ts *.json *.yml .github",
    "format:check": "prettier --check src tests scripts .storybook *.mjs *.cjs *.ts *.json *.yml .github",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/check-test-results.mjs vitest --clear && vitest run && node scripts/check-test-results.mjs vitest",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "test:coverage": "node scripts/check-test-results.mjs vitest --clear && vitest run --coverage && node scripts/check-test-results.mjs vitest",
    "test:accounts": "node scripts/check-test-results.mjs accounts --clear && vitest run --config vitest.accounts.config.ts && node scripts/check-test-results.mjs accounts",
    "test:production": "node scripts/check-test-results.mjs production --clear && vitest run --config vitest.production.config.ts && node scripts/check-test-results.mjs production",
    "test:e2e": "node scripts/check-test-results.mjs playwright --clear && playwright test && node scripts/check-test-results.mjs playwright",
    "check:boundaries": "node scripts/check-boundaries.mjs && node scripts/check-architecture.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:boundaries && npm run test:coverage",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "check:all": "npm run check && npm run test:accounts && npm run audit:dependencies && npm run build:production && npm run test:production && npm run build:preview && npm run build:storybook && npm run test:e2e",
    "audit:dependencies": "npm audit --audit-level=low",
    "auth:operator": "node --conditions=react-server --import tsx scripts/auth-operator.ts",
    "preview:storybook": "vite preview --outDir storybook-static --host 127.0.0.1 --port 6007 --strictPort",
    "build:preview": "node scripts/app.mjs build preview",
    "start:preview": "node scripts/app.mjs start preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@storybook/nextjs-vite": "10.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "jsdom": "30.1.3",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/client-secrets-manager": "3.1156.0",
    "@aws-sdk/lib-dynamodb": "3.1156.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@tanstack/react-table": "9.3.1",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "packageManager": "npm@11.19.1"
}
